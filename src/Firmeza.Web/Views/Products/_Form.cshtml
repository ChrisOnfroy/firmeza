@model Firmeza.Web.Models.Product
<form method="post" class="col-md-7">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input asp-for="Id" type="hidden" />
    <div class="mb-3"><label asp-for="Code"></label><input asp-for="Code" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Name"></label><input asp-for="Name" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Description"></label><textarea asp-for="Description" class="form-control"></textarea></div>
    <div class="mb-3"><label asp-for="UnitOfMeasure"></label><input asp-for="UnitOfMeasure" class="form-control" /></div>
    <div class="mb-3"><label asp-for="ProductCategoryId">Category</label><select asp-for="ProductCategoryId" asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))" class="form-select"><option value="">Select a category</option></select></div>
    <div class="mb-3"><label asp-for="UnitPrice"></label><input asp-for="UnitPrice" class="form-control" /></div>
    <div class="mb-3"><label asp-for="CurrentStock"></label><input asp-for="CurrentStock" class="form-control" /></div>
    <div class="mb-3"><label asp-for="MinimumStock"></label><input asp-for="MinimumStock" class="form-control" /></div>
    <div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive"></label></div>
    <button class="btn btn-primary" type="submit">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
