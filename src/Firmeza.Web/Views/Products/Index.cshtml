@model IEnumerable<Firmeza.Web.Models.Product>
@{
    ViewData["Title"] = "Products";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Products</h1>
    <a asp-action="Create" class="btn btn-primary">New product</a>
</div>
<table class="table table-striped">
    <thead><tr><th>Code</th><th>Name</th><th>Category</th><th>Unit price</th><th>Stock</th><th></th></tr></thead>
    <tbody>
    @foreach (var product in Model)
    {
        <tr><td>@product.Code</td><td>@product.Name</td><td>@product.ProductCategory?.Name</td><td>@product.UnitPrice</td><td>@product.CurrentStock</td><td><a asp-action="Edit" asp-route-id="@product.Id">Edit</a></td></tr>
    }
    </tbody>
</table>
