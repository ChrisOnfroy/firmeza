@model Firmeza.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}
<h1>Sign in</h1>
<form asp-action="Login" method="post" class="col-md-5">
    <input asp-for="ReturnUrl" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Email"></label><input asp-for="Email" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Password"></label><input asp-for="Password" class="form-control" /></div>
    <div class="form-check mb-3"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe"></label></div>
    <button class="btn btn-primary" type="submit">Sign in</button>
    <a asp-action="Register" class="btn btn-link">Register</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
