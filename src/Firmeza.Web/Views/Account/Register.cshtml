@model Firmeza.Web.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}
<h1>Register</h1>
<form asp-action="Register" method="post" class="col-md-5">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Email"></label><input asp-for="Email" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Password"></label><input asp-for="Password" class="form-control" /></div>
    <div class="mb-3"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" class="form-control" /></div>
    <button class="btn btn-primary" type="submit">Register</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
