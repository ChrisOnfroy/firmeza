@model IEnumerable<Firmeza.Web.Models.Customer>
@{
    ViewData["Title"] = "Customers";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Customers</h1>
    <a asp-action="Create" class="btn btn-primary">New customer</a>
</div>
<table class="table table-striped">
    <thead><tr><th>Document</th><th>Name</th><th>Email</th><th>Phone</th><th></th></tr></thead>
    <tbody>
    @foreach (var customer in Model)
    {
        <tr><td>@customer.DocumentType @customer.DocumentNumber</td><td>@customer.Name</td><td>@customer.Email</td><td>@customer.Phone</td><td><a asp-action="Edit" asp-route-id="@customer.Id">Edit</a></td></tr>
    }
    </tbody>
</table>
